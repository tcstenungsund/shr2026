{% extends "page.html.twig" %}

{% block head %}
{% endblock %}

{% block content %}
  <div class="interior-page interior-page--nyheter">
    <div class="background-image-region section-hero">
      {% if page.nyheter_background_image %}
        <div class="background-image-media">
          {{ page.nyheter_background_image }}
        </div>
      {% endif %}

      {% if page.small_logo %}
        <div class="small-logo-region">
          {{ page.small_logo }}
        </div>
      {% endif %}

      <h1 class="section-hero-title">Nyheter</h1>
    </div>

    {% if page.navbar_region %}
      <div class="navbar-region">
        <div class="frontpage-navbar-inner">
          {{ page.navbar_region }}
        </div>
      </div>
    {% endif %}

    <div class="interior-layout interior-layout--nyheter">
      <main class="interior-region interior-region--primary">
        <a href="#main-content" id="main-content" tabindex="-1"></a>
        {{ page.content }}
        {{ page.nyheter_content }}
      </main>
    </div>
  </div>
{% endblock %}
