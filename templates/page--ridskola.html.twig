{% extends "page.html.twig" %}

{% block head %}
{% endblock %}

{% block content %}
  <div class="interior-page interior-page--ridskola">
    <div class="background-image-region section-hero">
      {% if page.ridskola_background_image %}
        <div class="background-image-media">
          {{ page.ridskola_background_image }}
        </div>
      {% endif %}

      {% if page.small_logo %}
        <div class="small-logo-region">
          {{ page.small_logo }}
        </div>
      {% endif %}

      <h1 class="section-hero-title">Ridskola</h1>
    </div>

    {% if page.navbar_region %}
      <div class="navbar-region">
        <div class="frontpage-navbar-inner">
          {{ page.navbar_region }}
        </div>
      </div>
    {% endif %}

    <div class="interior-layout interior-layout--ridskola">
      <a href="#main-content" id="main-content" tabindex="-1"></a>

      {% if page.ridskola_sidebar_1 or page.content or page.ridskola_content_1 %}
        <div class="interior-row interior-row--media-left">
          <aside class="interior-region interior-region--side">
            {{ page.ridskola_sidebar_1 }}
          </aside>
          <main class="interior-region interior-region--main">
            {{ page.content }}
            {{ page.ridskola_content_1 }}
          </main>
        </div>
      {% endif %}

      {% if page.ridskola_content_2 or page.ridskola_sidebar_2 %}
        <div class="interior-row interior-row--media-right">
          <section class="interior-region interior-region--main">
            {{ page.ridskola_content_2 }}
          </section>
          <aside class="interior-region interior-region--side">
            {{ page.ridskola_sidebar_2 }}
          </aside>
        </div>
      {% endif %}

      {% if page.ridskola_sidebar_3 or page.ridskola_content_3 %}
        <div class="interior-row interior-row--media-left interior-row--wide-side">
          <aside class="interior-region interior-region--side">
            {{ page.ridskola_sidebar_3 }}
          </aside>
          <section class="interior-region interior-region--main">
            {{ page.ridskola_content_3 }}
          </section>
        </div>
      {% endif %}

      {% if page.ridskola_content_4 %}
        <section class="interior-region interior-region--full">
          {{ page.ridskola_content_4 }}
        </section>
      {% endif %}
    </div>
  </div>
{% endblock %}
