{% extends "page.html.twig" %}

{% block head %}
{% endblock %}

{% block content %}

{# =============================== #}
{#   BACKGROUND IMAGE + LOGO       #}
{# =============================== #}

{% if page.background_image or page.logo_region or page.small_logo %}
  <div class="background-image-region">

    {% if page.background_image %}
      <div class="background-image-media">
        {{ page.background_image }}
      </div>
    {% endif %}

    {% if page.small_logo %}
      <div class="small-logo-region">
        {{ page.small_logo }}
      </div>
    {% endif %}

    {% if page.logo_region %}
      <div class="logo-region">
        {{ page.logo_region }}
      </div>
    {% endif %}

  </div>
{% endif %}

{% if page.navbar_region %}
  <div class="navbar-region">
    <div class="frontpage-navbar-inner">
      {{ page.navbar_region }}
    </div>
  </div>
{% endif %}

{# =============================== #}
{#   MAIN LAYOUT: LEFT - MID - RIGHT #}
{# =============================== #}

<div class="frontpage-layout">

  {# LEFT GALLERY #}
  <div class="left-gallery">
    {% if page.left_gallery %}
      {{ page.left_gallery }}
    {% endif %}
  </div>

  {# MAIN CONTENT #}
  <div class="main-content">
    {% if page.content %}
      {{ page.content }}
    {% endif %}
  </div>

  {# RIGHT SIDE #}
  <div class="right-gallery">

    {# EVENTS ON TOP #}
    {% if page.right_events %}
      <div class="right-events">
        {{ page.right_events }}
      </div>
    {% endif %}

    {# RIGHT GALLERY #}
    {% if page.right_gallery %}
      <div class="right-gallery-content">
        {{ page.right_gallery }}
      </div>
    {% endif %}

  </div>

</div>

{% endblock %}

{% block footer %}
  <div class="{{ container }}">

    {% if page.footer_first or page.footer_second or page.footer_third or page.footer_fourth %}
      <div class="site-footer__top clearfix">

        {{ page.footer_first }}
        {{ page.footer_second }}
        {{ page.footer_third }}
        {{ page.footer_fourth }}

      </div>
    {% endif %}

    {% if page.footer_fifth %}
      <div class="site-footer__bottom">
        {{ page.footer_fifth }}
      </div>
    {% endif %}

  </div>
{% endblock %}
